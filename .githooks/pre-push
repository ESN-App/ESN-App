#!/bin/sh
# Runs the same checks as CI for the parts this branch changed. Skip once with `git push --no-verify`.
set -e
root=$(git rev-parse --show-toplevel)
git fetch -q origin main 2>/dev/null || true
changed=$(git diff --name-only origin/main...HEAD 2>/dev/null || git diff --name-only HEAD~1)

# Angular CLI needs Node >= 24.15; pick it from nvm when the default shell Node is older.
if [ -s "$HOME/.nvm/nvm.sh" ]; then . "$HOME/.nvm/nvm.sh"; nvm use --silent 24 >/dev/null 2>&1 || true; fi

if echo "$changed" | grep -q '^backend/'; then
  echo "pre-push: backend build + test"
  dotnet test "$root/backend/EsnApp.sln" --configuration Release --nologo -v q
fi

if echo "$changed" | grep -q '^frontend/'; then
  echo "pre-push: frontend lint + test + build"
  cd "$root/frontend"
  npm run lint --silent
  npm test --silent -- --watch=false
  npm run build --silent
fi
