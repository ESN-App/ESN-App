# Copy to .env for docker compose, adjust as needed. Never commit real secrets.

# PostgreSQL (used by the postgres container and the backend connection string)
POSTGRES_DB=esn_dev
POSTGRES_USER=esn
POSTGRES_PASSWORD=devpassword

# Backend
ASPNETCORE_ENVIRONMENT=Development
# JWT signing key — must be at least 32 characters; generate a strong random value for production
JWT_KEY=dev-only-jwt-signing-key-change-me-in-production-0123456789

# Development seed account (created on startup when migrations run; leave empty to skip)
SEED_ADMIN_EMAIL=admin@esngdansk.local
SEED_ADMIN_PASSWORD=Admin123!

# Outgoing email (password reset links). Leave EMAIL_SMTP_HOST empty to log emails to the
# backend console instead of sending them — handy for local development without real credentials.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=esngdanskdeveloper@gmail.com
EMAIL_SMTP_PASSWORD=kibh ssuf lysr jotx
EMAIL_FROM_ADDRESS=esngdanskdeveloper@gmail.com
EMAIL_FROM_NAME=ESN Gdańsk
# Public URL of the frontend, used to build links inside emails
FRONTEND_BASE_URL=http://localhost:4200
