# Copy to .env for docker compose, adjust as needed. Never commit real secrets.

# PostgreSQL (used by the postgres container and the backend connection string)
POSTGRES_DB=esn_dev
POSTGRES_USER=esn
POSTGRES_PASSWORD=devpassword

# Backend
ASPNETCORE_ENVIRONMENT=Development
# JWT signing key — must be at least 32 characters; generate a strong random value for production
JWT_KEY=dev-only-jwt-signing-key-change-me-in-production-0123456789

# Development seed account (created on startup when migrations run; leave empty to skip)
SEED_ADMIN_EMAIL=admin@esngdansk.local
SEED_ADMIN_PASSWORD=Admin123!
