<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Admin-uploaded images are runtime data written into wwwroot while the app runs, and
      wwwroot lives inside the project directory. Without this exclusion every upload looks
      like a project change: dotnet watch / VS Hot Reload sees the added file, Roslyn's
      HotReloadMSBuildWorkspace throws (dotnet/roslyn#84062) and the watcher shuts the
      backend down mid-request - the upload is written before the entity is saved, so the
      save silently never happens. This must be a glob exclusion rather than an
      <Content Remove/>: item removals are materialised at build time and do not cover
      files created afterwards. It also keeps dev uploads out of the published output.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\images\uploads\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EsnApp.Application\EsnApp.Application.csproj" />
    <ProjectReference Include="..\EsnApp.Infrastructure\EsnApp.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\images\uploads\partners\" />
  </ItemGroup>

</Project>
