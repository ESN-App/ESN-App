# Copy to /opt/esn/.env (chmod 600). Never commit real values.

# Public hostname. PoC without a domain: server IP with dashes + .sslip.io, e.g. 1-2-3-4.sslip.io
APP_DOMAIN=1-2-3-4.sslip.io
# Image tag to run, e.g. v0.5.9 (deploy.sh sets this)
IMAGE_TAG=latest
# Optional commit SHA shown in /api/version (API reads GIT_COMMIT once PR #138 is merged)
GIT_COMMIT=

POSTGRES_PASSWORD=change-me-long-random
# At least 32 characters: openssl rand -base64 48
JWT_KEY=change-me-at-least-32-characters-random

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password
# PoC: true. Needs PR #136 (Seed:SampleData); before it is merged sample data is always seeded.
SEED_SAMPLE_DATA=true

# Gmail SMTP (STARTTLS), separate sender account with 2-Step Verification and an app password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=sender@gmail.com
EMAIL_SMTP_PASSWORD=change-me-16-char-app-password
EMAIL_FROM_ADDRESS=sender@gmail.com
EMAIL_FROM_NAME=ESN Gdańsk
